# 复制为 .env 后填写，或运行 ./init-env.sh 自动生成随机密钥。
# .env 含密钥，不要提交到 Git。

# 站点域名（先把域名的 A 记录指向服务器 IP）
DOMAIN=api.example.com
# 申请 HTTPS 证书用的邮箱
ACME_EMAIL=admin@example.com

# 建议固定到具体版本，例如 calciumion/new-api:v1.0.0-rc.51；以后改成自己 fork 构建的镜像
NEW_API_IMAGE=calciumion/new-api:latest

# 以下密钥请用 openssl rand -hex 32 生成，只用字母和数字
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
SESSION_SECRET=change-me
CRYPTO_SECRET=change-me

TZ=Asia/Shanghai
# 流式无响应超时（秒）
STREAMING_TIMEOUT=300
